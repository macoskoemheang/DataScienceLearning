# Copy this file to .env and fill in real values. .env is gitignored.

# Local SQLite (default if DATABASE_URL is unset):
#   no need to set anything.
#
# Supabase Postgres (get this from Supabase dashboard -> Project Settings
# -> Database -> Connection string -> URI, "Session pooler" mode recommended
# for a serverless-style app; use "Direct connection" for long-lived servers).
# Note the "+psycopg" -- this project uses the psycopg3 driver:
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Set this to a strong random value in any real deployment.
JWT_SECRET_KEY=change-me-to-a-long-random-string
